function orient(options = {}) {
  const project = detectProject();
  const importantFiles = [
    'README.md',
    'package.json',
    'package-lock.json',
    'vite.config.ts',
    'eslint.config.js',
    'tsconfig.json',
    '.harness/contract.yml',
    '.harness/friction.jsonl',
  ].map((filePath) => ({ path: filePath, exists: fileExists(filePath) }));
  const availableCommands = [
    { name: 'help', command: './harness help', status: 'detected' },
    { name: 'orient', command: './harness orient', status: 'detected' },
    { name: 'doctor', command: './harness doctor', status: 'detected' },
    ...Object.entries(project.commands).map(([name, config]) => ({ name, command: config.command, status: config.status })),
    { name: 'verify', command: './harness verify', status: 'detected' },
    { name: 'status', command: './harness status', status: 'detected' },
    { name: 'friction add', command: './harness friction add', status: 'detected' },
    { name: 'friction list', command: './harness friction list', status: 'detected' },
  ];
  const checks = importantFiles.map((file) => ({
    id: file.path,
    status: file.exists ? 'pass' : 'missing',
  }));
  const resultValue = result('orient', 'pass', 'pass', checks, '', 'Run ./harness doctor before changing code.', {
    available_commands: availableCommands,
    important_files: importantFiles,
    project,
  });
  printOrient(resultValue, options);
  return EXIT.pass;
}

function doctor(options = {}, context = {}) {
  const runDir = context.runDir || createRunDir('doctor');
  const project = detectProject();
  const packageManagerName = project.packageManager.name;
  const checks = [
    { id: 'node', status: commandExists('node') ? 'pass' : 'fail', detail: 'Node.js runtime is required.' },
    { id: packageManagerName, status: commandExists(packageManagerName) ? 'pass' : 'fail', detail: `${packageManagerName} package manager is required.` },
    { id: 'package.json', status: fileExists('package.json') ? 'pass' : 'fail', detail: 'Project manifest.' },
    { id: 'package-lock.json', status: fileExists('package-lock.json') ? 'pass' : 'missing', detail: 'npm lockfile.' },
    { id: 'node_modules', status: fileExists('node_modules') ? 'pass' : 'fail', detail: 'Dependencies appear installed.' },
    { id: 'vite.config.ts', status: fileExists('vite.config.ts') ? 'pass' : 'missing', detail: 'Vite config.' },
    { id: 'eslint.config.js', status: fileExists('eslint.config.js') ? 'pass' : 'missing', detail: 'ESLint config.' },
    { id: 'tsconfig.json', status: fileExists('tsconfig.json') ? 'pass' : 'missing', detail: 'TypeScript config.' },
    { id: 'contract', status: fs.existsSync(CONTRACT_PATH) ? 'pass' : 'fail', detail: relativeToRoot(CONTRACT_PATH) },
    { id: 'evidence', status: fs.existsSync(RUNS_DIR) ? 'pass' : 'fail', detail: relativeToRoot(RUNS_DIR) },
    { id: 'friction', status: fs.existsSync(FRICTION_PATH) ? 'pass' : 'fail', detail: relativeToRoot(FRICTION_PATH) },
  ];
  const hardFailures = checks.filter((check) => check.status === 'fail');
  const softMissing = checks.filter((check) => check.status === 'missing');
  const verdict = hardFailures.length ? 'fail' : softMissing.length ? 'degraded' : 'pass';
  const status = verdict;
  const nextAction = hardFailures.length
    ? 'Install missing tools or dependencies, then rerun ./harness doctor.'
    : softMissing.length
      ? 'Review missing optional config, then continue if acceptable.'
      : 'Run ./harness verify before completion.';
  const resultValue = result('doctor', status, verdict, checks, relativeToRoot(runDir), nextAction, {
    package_manager: project.packageManager,
  });
  writeJson(path.join(runDir, 'doctor.json'), resultValue);
  updateLatest(runDir, resultValue);
  if (!context.quiet) {
    printResult(resultValue, options);
  }
  return resultValue;
}

function runShell(commandName, command, runDir, options = {}) {
  return new Promise((resolve) => {
    const logPath = path.join(runDir, `${commandName}.log`);
    const logStream = fs.createWriteStream(logPath, { flags: 'a' });
    const startedAt = timestamp();
    logStream.write(`$ ${command}\n`);
    const child = spawn(command, {
      cwd: ROOT,
      env: { ...process.env, CI: process.env.CI || '1' },
      shell: true,
    });
    child.stdout.on('data', (data) => {
      logStream.write(data);
      if (options.stream) process.stdout.write(data);
    });
    child.stderr.on('data', (data) => {
      logStream.write(data);
      if (options.stream) process.stderr.write(data);
    });
    child.on('close', (exitCode) => {
      const completedAt = timestamp();
      logStream.write(`\nexit_code=${exitCode}\n`);
      logStream.end(() => {
        resolve({
          completed_at: completedAt,
          exit_code: exitCode,
          log_path: logPath,
          started_at: startedAt,
        });
      });
    });
  });
}

async function wrappedCommand(commandName, options = {}, context = {}) {
  const project = detectProject();
  const config = project.commands[commandName];
  const runDir = context.runDir || createRunDir(commandName);
  if (!configured(config)) {
    const resultValue = result(commandName, 'not_configured', 'unknown', [{ id: commandName, status: 'not_configured' }], relativeToRoot(runDir), `Configure ${commandName} in package.json or .harness/contract.yml.`);
    writeJson(path.join(runDir, `${commandName}.json`), resultValue);
    updateLatest(runDir, resultValue);
    if (!context.quiet) printResult(resultValue, options);
    return resultValue;
  }
  const execution = await runShell(commandName, config.command, runDir, { stream: options.stream });
  const passed = execution.exit_code === 0;
  const checks = [{
    evidence: `${commandName}.log`,
    exit_code: execution.exit_code,
    id: commandName,
    status: passed ? 'pass' : 'fail',
  }];
  const resultValue = result(
    commandName,
    passed ? 'pass' : 'fail',
    passed ? 'pass' : 'fail',
    checks,
    relativeToRoot(runDir),
    passed ? 'Continue with ./harness verify when ready.' : `Inspect ${relativeToRoot(execution.log_path)}, fix ${commandName}, then rerun ./harness ${commandName}.`,
    {
      command_line: config.command,
      completed_at: execution.completed_at,
      started_at: execution.started_at,
    },
  );
  writeJson(path.join(runDir, `${commandName}.json`), resultValue);
  updateLatest(runDir, resultValue);
  if (!context.quiet) printResult(resultValue, options);
  return resultValue;
}

function fatalBootLogMatch(output) {
  const plainOutput = output.replace(/\u001b\[[0-9;]*m/g, '');
  const match = FATAL_BOOT_LOG_PATTERNS.find((pattern) => pattern.test(plainOutput));
  return match ? match.source : '';
}

function probe(url) {
  return new Promise((resolve) => {
    const request = http.get(url, { timeout: 1000 }, (response) => {
      response.resume();
      resolve({
        ok: response.statusCode >= 200 && response.statusCode < 300,
        statusCode: response.statusCode,
      });
    });
    request.on('timeout', () => {
      request.destroy();
      resolve({ ok: false, statusCode: null });
    });
    request.on('error', () => resolve({ ok: false, statusCode: null }));
  });
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function stopProcess(child, signal = 'SIGTERM') {
  if (child.exitCode !== null || child.signalCode !== null) {
    return;
  }
  try {
    if (process.platform !== 'win32') {
      process.kill(-child.pid, signal);
    } else {
      child.kill(signal);
    }
  } catch (_error) {
    try {
      child.kill('SIGTERM');
    } catch (_innerError) {
      return;
    }
  }
}

async function boot(options = {}, context = {}) {
  const project = detectProject();
  const config = project.commands.boot;
  const runDir = context.runDir || createRunDir('boot');
  if (!configured(config)) {
    const resultValue = result('boot', 'not_configured', 'unknown', [{ id: 'boot', status: 'not_configured' }], relativeToRoot(runDir), 'Add a boot command and readiness check to .harness/contract.yml.');
    writeJson(path.join(runDir, 'boot.json'), resultValue);
    updateLatest(runDir, resultValue);
    if (!context.quiet) printResult(resultValue, options);
    return resultValue;
  }

  const logPath = path.join(runDir, 'boot.log');
  const logStream = fs.createWriteStream(logPath, { flags: 'a' });
  const startedAt = timestamp();
  logStream.write(`$ ${config.command}\n`);
  const child = spawn(config.command, {
    cwd: ROOT,
    detached: process.platform !== 'win32',
    env: { ...process.env, CI: process.env.CI || '1' },
    shell: true,
  });
  let exitCode = null;
  let closed = false;
  let bootOutput = '';
  child.stdout.on('data', (data) => {
    bootOutput += data.toString();
    logStream.write(data);
    if (options.stream) process.stdout.write(data);
  });
  child.stderr.on('data', (data) => {
    bootOutput += data.toString();
    logStream.write(data);
    if (options.stream) process.stderr.write(data);
  });
  child.on('close', (code) => {
    exitCode = code;
    closed = true;
  });

  let ready = false;
  const timeoutAt = Date.now() + 20000;
  let readinessStatusCode = null;
  while (Date.now() < timeoutAt) {
    const probeResult = await probe(BOOT_URL);
    ready = probeResult.ok;
    readinessStatusCode = probeResult.statusCode;
    if (ready) break;
    if (closed) break;
    await sleep(500);
  }
  if (ready) {
    await sleep(2000);
  }
  const fatalBootPattern = fatalBootLogMatch(bootOutput);
  stopProcess(child, 'SIGINT');
  await sleep(500);
  logStream.write(`\nreadiness_url=${BOOT_URL}\nreadiness_status_code=${readinessStatusCode === null ? '' : readinessStatusCode}\nready=${ready}\nfatal_boot_pattern=${fatalBootPattern}\nexit_code=${exitCode === null ? '' : exitCode}\n`);
  await new Promise((resolve) => logStream.end(resolve));

  const passed = ready && !fatalBootPattern;
  const checks = [{
    evidence: 'boot.log',
    exit_code: exitCode,
    id: 'boot-readiness',
    status: passed ? 'pass' : 'fail',
    fatal_pattern: fatalBootPattern,
    status_code: readinessStatusCode,
    url: BOOT_URL,
  }];
  const resultValue = result(
    'boot',
    passed ? 'pass' : 'fail',
    passed ? 'pass' : 'fail',
    checks,
    relativeToRoot(runDir),
    passed ? 'Boot readiness proved by a 2xx root route response and clean startup log.' : `Inspect ${relativeToRoot(logPath)}, then fix the boot path or readiness check.`,
    {
      command_line: config.command,
      completed_at: timestamp(),
      fatal_boot_pattern: fatalBootPattern,
      readiness_url: BOOT_URL,
      readiness_status_code: readinessStatusCode,
      started_at: startedAt,
    },
  );
  writeJson(path.join(runDir, 'boot.json'), resultValue);
  updateLatest(runDir, resultValue);
  if (!context.quiet) printResult(resultValue, options);
  return resultValue;
}

function latestEvidence() {
  return readJson(LATEST_PATH, null);
}

function frictionEntries() {
  if (!fs.existsSync(FRICTION_PATH)) {
    return [];
  }
  return fs.readFileSync(FRICTION_PATH, 'utf8')
    .split('\n')
    .filter(Boolean)
    .map((line) => {
      try {
        return JSON.parse(line);
      } catch (_error) {
        return { malformed: true, raw: line };
      }
    });
}

function status(options = {}) {
  const project = detectProject();
  const latest = latestEvidence();
  const friction = frictionEntries();
  const availableCommands = Object.entries(project.commands).map(([name, config]) => ({
    command: config.command,
    name,
    status: config.status,
  }));
  const missingChecks = availableCommands.filter((command) => command.status === 'not_configured' || command.status === 'missing');
  const checks = [
    { id: 'contract', status: fs.existsSync(CONTRACT_PATH) ? 'pass' : 'fail' },
    { id: 'evidence', status: fs.existsSync(RUNS_DIR) ? 'pass' : 'fail' },
    { id: 'friction', status: fs.existsSync(FRICTION_PATH) ? 'pass' : 'fail' },
  ];
  const resultValue = result('status', checks.every((check) => check.status === 'pass') ? 'pass' : 'fail', checks.every((check) => check.status === 'pass') ? 'pass' : 'fail', checks, latest ? latest.evidence_path : '', missingChecks.length ? 'Configure missing checks or keep their unknown status honest.' : 'Run ./harness verify before completion.', {
    available_commands: availableCommands,
    contract_exists: fs.existsSync(CONTRACT_PATH),
    friction_count: friction.length,
    known_missing_checks: missingChecks,
    latest_evidence: latest,
  });
  if (options.json) {
    console.log(JSON.stringify(resultValue, null, 2));
    return exitCodeFor(resultValue);
  }
  printResult(resultValue, options);
  console.log(`contract: ${resultValue.contract_exists ? 'present' : 'missing'}`);
  console.log(`latest evidence: ${latest ? latest.evidence_path : 'none'}`);
  console.log(`friction count: ${friction.length}`);
  console.log('available commands:');
  for (const command of availableCommands) {
    const wrapped = command.command ? ` -> ${command.command}` : '';
    console.log(`- ${command.name}: ${command.status}${wrapped}`);
  }
  if (missingChecks.length) {
    console.log('known missing checks:');
    for (const missing of missingChecks) {
      console.log(`- ${missing.name}: ${missing.status}`);
    }
  }
  return exitCodeFor(resultValue);
}

async function verify(options = {}) {
  const runDir = createRunDir('verify');
  const project = detectProject();
  const sequence = ['doctor', 'lint', 'test', 'build', 'boot'].filter((command) => command === 'doctor' || configured(project.commands[command]));
  const checkResults = [];
  for (const command of sequence) {
    if (command === 'doctor') {
      checkResults.push(doctor({}, { quiet: true, runDir }));
    } else if (command === 'boot') {
      checkResults.push(await boot({}, { quiet: true, runDir }));
    } else {
      checkResults.push(await wrappedCommand(command, {}, { quiet: true, runDir }));
    }
  }
  const checks = checkResults.map((check) => ({
    evidence: check.command === 'doctor' ? 'doctor.json' : `${check.command}.log`,
    exit_code: check.checks && check.checks[0] ? check.checks[0].exit_code : undefined,
    id: check.command,
    status: check.verdict,
  }));
  const hasFail = checkResults.some((check) => check.verdict === 'fail');
  const hasUnknown = checkResults.some((check) => check.verdict === 'unknown');
  const hasDegraded = checkResults.some((check) => check.verdict === 'degraded');
  const verdict = hasFail ? 'fail' : hasUnknown ? 'unknown' : hasDegraded ? 'degraded' : 'pass';
  const nextAction = verdict === 'pass'
    ? 'Verification passed. Evidence is authoritative.'
    : verdict === 'degraded'
      ? 'Review degraded checks, then rerun ./harness verify if the missing checks must be enforced.'
      : verdict === 'unknown'
        ? 'Configure unknown checks, then rerun ./harness verify.'
        : 'Fix failing checks, then rerun ./harness verify.';
  const resultValue = result(
    'verify',
    verdict,
    verdict,
    checks,
    relativeToRoot(runDir),
    nextAction,
    {
      completed_at: timestamp(),
      sequence,
      started_at: readJson(path.join(runDir, 'run.json'), {}).started_at,
    },
  );
  writeJson(path.join(runDir, 'verify.json'), resultValue);
  writeText(path.join(runDir, 'summary.md'), summaryMarkdown(resultValue));
  updateLatest(runDir, resultValue);
  printResult(resultValue, options);
  return exitCodeFor(resultValue);
}

function summaryMarkdown(resultValue) {
  const lines = [
    '# Harness Verification Summary',
    '',
    `- **Status:** ${resultValue.status}`,
    `- **Verdict:** ${resultValue.verdict}`,
    `- **Evidence:** ${resultValue.evidence_path}`,
    '',
    '## Checks',
    '',
  ];
  for (const check of resultValue.checks) {
    lines.push(`- ${check.id}: ${check.status}${check.evidence ? ` (${check.evidence})` : ''}`);
  }
  lines.push('', '## Next Action', '', resultValue.next_action, '');
  return lines.join('\n');
}

function prompt(question) {
  if (!process.stdin.isTTY) {
    return Promise.resolve('');
  }
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  return new Promise((resolve) => {
    rl.question(`${question}: `, (answer) => {
      rl.close();
      resolve(answer.trim());
    });
  });
}

async function frictionAdd(options = {}) {
  ensureDir(HARNESS_DIR);
  const inference = options.inference || await prompt('What did the agent have to infer');
  const shouldProve = options.shouldProve || await prompt('What should the harness have proved');
  const helpedBy = options.helpedBy || await prompt('What command, check, fixture, output, or error would have helped');
  const severity = options.severity || await prompt('How severe was it');
  const blockedAnswer = options.blocked !== undefined ? String(options.blocked) : await prompt('Was progress blocked');
  if (!inference || !shouldProve || !helpedBy) {
    const resultValue = result('friction add', 'fail', 'fail', [{ id: 'required-fields', status: 'fail' }], '', 'Provide --inference, --should-prove, and --helped-by.');
    printResult(resultValue, options);
    return EXIT.failure;
  }
  const entry = {
    timestamp: timestamp(),
    inference,
    should_have_proved: shouldProve,
    helpful_proof: helpedBy,
    severity: severity || 'unknown',
    blocked: ['true', 'yes', '1'].includes(String(blockedAnswer).toLowerCase()),
    source: 'harness friction add',
    key_question: KEY_QUESTION,
  };
  fs.appendFileSync(FRICTION_PATH, `${JSON.stringify(entry)}\n`);
  const resultValue = result('friction add', 'pass', 'pass', [{ id: 'friction', status: 'recorded' }], relativeToRoot(FRICTION_PATH), 'Review recurring friction and promote it into harness checks.', { entry });
  printResult(resultValue, options);
  return EXIT.pass;
}

function frictionList(options = {}) {
  const limit = Number.parseInt(options.limit || '10', 10);
  const entries = frictionEntries();
  const recent = entries.slice(-limit);
  const resultValue = result('friction list', 'pass', 'pass', [{ id: 'friction-count', status: 'pass', detail: String(entries.length) }], relativeToRoot(FRICTION_PATH), entries.length ? 'Use repeated friction to improve .harness/contract.yml and ./harness checks.' : 'No friction recorded yet.', {
    entries: recent,
    total: entries.length,
  });
  if (options.json) {
    console.log(JSON.stringify(resultValue, null, 2));
    return EXIT.pass;
  }
  printResult(resultValue, options);
  if (recent.length) {
    for (const entry of recent) {
      console.log(`- ${entry.timestamp}: ${entry.inference || entry.raw}`);
      if (entry.should_have_proved) console.log(`  should prove: ${entry.should_have_proved}`);
      if (entry.helpful_proof) console.log(`  would help: ${entry.helpful_proof}`);
      if (entry.severity) console.log(`  severity: ${entry.severity}; blocked: ${entry.blocked}`);
    }
  }
  return EXIT.pass;
}

async function main() {
  ensureDir(HARNESS_DIR);
  ensureDir(RUNS_DIR);
  if (!fs.existsSync(FRICTION_PATH)) {
    fs.writeFileSync(FRICTION_PATH, '');
  }
  const { positional, options } = parseArgs(process.argv.slice(2));
  const command = positional[0] || 'help';
  if (command === 'help' || command === '--help' || command === '-h') {
    return printHelp(options);
  }
  if (command === 'orient') {
    return orient(options);
  }
  if (command === 'doctor') {
    const resultValue = doctor(options);
    return exitCodeFor(resultValue);
  }
  if (['install', 'check_config', 'lint', 'test', 'build', 'clean'].includes(command)) {
    const resultValue = await wrappedCommand(command, options);
    return exitCodeFor(resultValue);
  }
  if (command === 'boot') {
    const resultValue = await boot(options);
    return exitCodeFor(resultValue);
  }
  if (command === 'verify') {
    return verify(options);
  }
  if (command === 'status') {
    return status(options);
  }
  if (command === 'friction') {
    const subcommand = positional[1] || 'list';
    if (subcommand === 'add') {
      return frictionAdd(options);
    }
    if (subcommand === 'list') {
      return frictionList(options);
    }
  }
  const resultValue = result(command, 'not_configured', 'unknown', [{ id: command, status: 'unknown' }], '', 'Run ./harness help for supported commands.');
  printResult(resultValue, options);
  return EXIT.notConfigured;
}

main()
  .then((code) => {
    process.exitCode = code;
  })
  .catch((error) => {
    console.error(`[fail] harness: ${error instanceof Error ? error.message : String(error)}`);
    process.exitCode = EXIT.failure;
  });
