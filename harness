    { name: 'orient', description: 'Explain the repo and operating surface.' },
    { name: 'doctor', description: 'Check whether the repo is ready to operate.' },
    { name: 'install', description: 'Run the detected install command.' },
    { name: 'check_config', description: 'Run the detected config validation command.' },
    { name: 'lint', description: 'Run the detected lint command.' },
    { name: 'test', description: 'Run the detected test command.' },
    { name: 'build', description: 'Run the detected build command.' },
    { name: 'boot', description: 'Run the inferred Vite boot readiness check.' },
    { name: 'verify', description: 'Run doctor, lint, test, build, and boot.' },
    { name: 'status', description: 'Show harness state and latest evidence.' },
    { name: 'friction add', description: 'Record an inference the harness should have proved.' },
