#!/usr/bin/env node

import { spawn, spawnSync } from 'node:child_process';
import fs from 'node:fs';
import http from 'node:http';
import path from 'node:path';
import readline from 'node:readline';
import { fileURLToPath } from 'node:url';

const ROOT = path.dirname(fileURLToPath(import.meta.url));
const HARNESS_DIR = path.join(ROOT, '.harness');
const CONTRACT_PATH = path.join(HARNESS_DIR, 'contract.yml');
const EVIDENCE_DIR = path.join(HARNESS_DIR, 'evidence');
const RUNS_DIR = path.join(EVIDENCE_DIR, 'runs');
const LATEST_PATH = path.join(EVIDENCE_DIR, 'latest.json');
const FRICTION_PATH = path.join(HARNESS_DIR, 'friction.jsonl');
const README_PATH = path.join(HARNESS_DIR, 'README.md');
const KEY_QUESTION = 'What did the agent have to infer that the harness should have proved?';
const BOOT_URL = 'http://127.0.0.1:4173/';
const BOOT_COMMAND = 'npm run dev -- --host 127.0.0.1 --port 4173 --strictPort';
const EXIT = {
  pass: 0,
  failure: 1,
  doctorFailure: 10,
  notConfigured: 20,
  verificationFailure: 30,
  bootFailure: 40,
  contractProblem: 50,
  frictionRecorded: 60,
};

const IMPORTANT_COMMANDS = new Set([
  'orient',
  'doctor',
  'lint',
  'test',
  'build',
  'boot',
  'verify',
  'status',
  'clean',
]);

const BOOLEAN_OPTIONS = new Set(['json', 'stream']);
const BOOLEAN_VALUE_OPTIONS = new Set(['blocked']);
const BOOLEAN_VALUES = new Set(['true', 'false', 'yes', 'no', '1', '0']);
const FATAL_BOOT_LOG_PATTERNS = [
  /error when starting dev server/i,
  /failed to scan for dependencies/i,
];

function ensureDir(dirPath) {
  fs.mkdirSync(dirPath, { recursive: true });
}

function readJson(filePath, fallback) {
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf8'));
  } catch (_error) {
    return fallback;
  }
}

function fileExists(relativePath) {
  return fs.existsSync(path.join(ROOT, relativePath));
}

function commandExists(command) {
  const check = process.platform === 'win32' ? 'where' : 'command';
  const args = process.platform === 'win32' ? [command] : ['-v', command];
  const result = spawnSync(check, args, { shell: process.platform !== 'win32', stdio: 'ignore' });
  return result.status === 0;
}

function packageJson() {
  return readJson(path.join(ROOT, 'package.json'), {});
}

function detectPackageManager() {
  if (fileExists('package-lock.json')) {
    return { name: 'npm', status: 'detected' };
  }
  if (fileExists('pnpm-lock.yaml')) {
    return { name: 'pnpm', status: 'detected' };
  }
  if (fileExists('yarn.lock')) {
    return { name: 'yarn', status: 'detected' };
  }
  if (fileExists('package.json')) {
    return { name: 'npm', status: 'inferred' };
  }
  return { name: 'unknown', status: 'missing' };
}

function packageCommand(packageManager, scriptName) {
  if (packageManager === 'pnpm') {
    return `pnpm ${scriptName}`;
  }
  if (packageManager === 'yarn') {
    return `yarn ${scriptName}`;
  }
  return `npm run ${scriptName}`;
}

function installCommand(packageManager) {
  if (packageManager === 'pnpm') {
    return 'pnpm install';
  }
  if (packageManager === 'yarn') {
    return 'yarn install';
  }
  return 'npm install';
}

function detectStack(pkg) {
  const allDeps = { ...(pkg.dependencies || {}), ...(pkg.devDependencies || {}) };
  const stack = [];
  if (allDeps.vite) stack.push('Vite');
  if (allDeps.react) stack.push('React');
  if (allDeps.typescript) stack.push('TypeScript');
  if (allDeps.vitest) stack.push('Vitest');
  if (allDeps.eslint) stack.push('ESLint');
  if (allDeps.prettier) stack.push('Prettier');
  if (allDeps.zod) stack.push('Zod');
  return stack;
}

function detectProject() {
  const pkg = packageJson();
  const packageManager = detectPackageManager();
  const scripts = pkg.scripts || {};
  const commands = {
    install: { command: installCommand(packageManager.name), status: packageManager.name === 'unknown' ? 'missing' : packageManager.status },
    check_config: scripts['check:config']
      ? { command: packageCommand(packageManager.name, 'check:config'), status: 'detected' }
      : { command: '', status: 'not_configured' },
    lint: scripts.lint
      ? { command: packageCommand(packageManager.name, 'lint'), status: 'detected' }
      : { command: '', status: 'not_configured' },
    test: scripts.test
      ? { command: packageCommand(packageManager.name, 'test'), status: 'detected' }
      : { command: '', status: 'not_configured' },
    build: scripts.build
      ? { command: packageCommand(packageManager.name, 'build'), status: 'detected' }
      : { command: '', status: 'not_configured' },
    boot: scripts.dev
      ? { command: BOOT_COMMAND, readiness: { type: 'http', url: BOOT_URL, status: 'inferred' }, status: 'inferred' }
      : { command: '', readiness: { type: 'none', status: 'missing' }, status: 'not_configured' },
    clean: scripts.clean
      ? { command: packageCommand(packageManager.name, 'clean'), status: 'detected' }
      : { command: '', status: 'not_configured' },
  };

  return {
    name: pkg.name || path.basename(ROOT),
    packageManager,
    scripts,
    stack: detectStack(pkg),
    type: scripts.dev && fileExists('vite.config.ts') ? { value: 'web_app', status: 'inferred' } : { value: 'unknown', status: 'missing' },
    language: fileExists('tsconfig.json') ? { value: 'TypeScript', status: 'detected' } : { value: 'unknown', status: 'missing' },
    commands,
  };
}

function configured(commandConfig) {
  return commandConfig && commandConfig.command && commandConfig.status !== 'not_configured' && commandConfig.status !== 'missing';
}

function timestamp() {
  return new Date().toISOString();
}

function safeTimestamp() {
  return timestamp().replace(/[:.]/g, '-');
}

function createRunDir(command) {
  ensureDir(RUNS_DIR);
  const runDir = path.join(RUNS_DIR, safeTimestamp());
  ensureDir(runDir);
  writeJson(path.join(runDir, 'run.json'), {
    command,
    root: ROOT,
    started_at: timestamp(),
  });
  return runDir;
}

function relativeToRoot(filePath) {
  if (!filePath) {
    return '';
  }
  return path.relative(ROOT, filePath).replace(/\\/g, '/');
}

function writeJson(filePath, value) {
  ensureDir(path.dirname(filePath));
  fs.writeFileSync(filePath, `${JSON.stringify(value, null, 2)}\n`);
}

function writeText(filePath, value) {
  ensureDir(path.dirname(filePath));
  fs.writeFileSync(filePath, value);
}

function updateLatest(runDir, result) {
  writeJson(LATEST_PATH, {
    command: result.command,
    evidence_path: relativeToRoot(runDir),
    status: result.status,
    updated_at: timestamp(),
    verdict: result.verdict,
  });
}

function result(command, status, verdict, checks, evidencePath, nextAction, extra = {}) {
  return {
    command,
    status,
    verdict,
    checks,
    evidence_path: evidencePath || '',
    next_action: nextAction || '',
    ...extra,
  };
}

function exitCodeFor(resultValue) {
  if (resultValue.verdict === 'pass') {
    return EXIT.pass;
  }
  if (resultValue.status === 'not_configured' || resultValue.verdict === 'unknown') {
    return EXIT.notConfigured;
  }
  if (resultValue.command === 'doctor') {
    return EXIT.doctorFailure;
  }
  if (resultValue.command === 'verify') {
    return EXIT.verificationFailure;
  }
  if (resultValue.command === 'boot') {
    return EXIT.bootFailure;
  }
  if (resultValue.command === 'contract') {
    return EXIT.contractProblem;
  }
  return EXIT.failure;
}

function parseArgs(argv) {
  const positional = [];
  const options = {};
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--json') {
      options.json = true;
      continue;
    }
    if (arg.startsWith('--')) {
      const withoutPrefix = arg.slice(2);
      const [rawKey, inlineValue] = withoutPrefix.split(/=(.*)/s, 2);
      const key = rawKey.replace(/-([a-z])/g, (_match, letter) => letter.toUpperCase());
      if (inlineValue !== undefined) {
        options[key] = inlineValue;
      } else if (BOOLEAN_OPTIONS.has(key)) {
        options[key] = true;
      } else if (BOOLEAN_VALUE_OPTIONS.has(key)) {
        const nextValue = argv[index + 1];
        if (nextValue && !nextValue.startsWith('--') && BOOLEAN_VALUES.has(nextValue.toLowerCase())) {
          options[key] = nextValue;
          index += 1;
        } else {
          options[key] = true;
        }
      } else if (argv[index + 1] && !argv[index + 1].startsWith('--')) {
        options[key] = argv[index + 1];
        index += 1;
      } else {
        options[key] = true;
      }
      continue;
    }
    positional.push(arg);
  }
  return { positional, options };
}

function printResult(resultValue, options = {}) {
  if (options.json) {
    console.log(JSON.stringify(resultValue, null, 2));
    return;
  }
  console.log(`[${resultValue.verdict}] ${resultValue.command}`);
  if (resultValue.status && resultValue.status !== resultValue.verdict) {
    console.log(`status: ${resultValue.status}`);
  }
  if (resultValue.summary) {
    console.log(resultValue.summary);
  }
  if (Array.isArray(resultValue.checks) && resultValue.checks.length > 0) {
    console.log('checks:');
    for (const check of resultValue.checks) {
      const detail = check.detail ? ` - ${check.detail}` : '';
      const exitCode = Number.isInteger(check.exit_code) ? ` (exit ${check.exit_code})` : '';
      console.log(`- ${check.id}: ${check.status}${exitCode}${detail}`);
    }
  }
  if (resultValue.evidence_path) {
    console.log(`evidence: ${resultValue.evidence_path}`);
  }
  if (resultValue.next_action) {
    console.log(`next: ${resultValue.next_action}`);
  }
}

function printOrient(resultValue, options = {}) {
  if (options.json) {
    console.log(JSON.stringify(resultValue, null, 2));
    return;
  }
  const project = resultValue.project;
  console.log(`[${resultValue.verdict}] orient`);
  console.log(`project: ${project.name}`);
  console.log(`type: ${project.type.value} (${project.type.status})`);
  console.log(`language: ${project.language.value} (${project.language.status})`);
  console.log(`package manager: ${project.packageManager.name} (${project.packageManager.status})`);
  console.log(`stack: ${project.stack.length ? project.stack.join(', ') : 'unknown'}`);
  console.log('important files:');
  for (const importantFile of resultValue.important_files) {
    console.log(`- ${importantFile.path}: ${importantFile.exists ? 'present' : 'missing'}`);
  }
  console.log('available harness commands:');
  for (const command of resultValue.available_commands) {
    const wrapped = command.command ? ` -> ${command.command}` : '';
    console.log(`- ${command.name}: ${command.status}${wrapped}`);
  }
  console.log(`evidence: ${relativeToRoot(EVIDENCE_DIR)}`);
  console.log(`friction: ${relativeToRoot(FRICTION_PATH)}`);
}

